# ============================================================
# Sahayak AI — Frontend Environment Variables
# ============================================================
# Copy to .env.local for development.
# NEXT_PUBLIC_ prefix = exposed to the browser bundle.
# Variables without this prefix = server-side only.
# ============================================================

# ── Backend API ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# ── App Metadata ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Sahayak AI
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Feature Flags (set to "true" to enable) ──────────────────
# The RAG assistant + voice are wired up; enable once the backend has a
# GROQ_API_KEY and the scheme index has been built (POST /api/v1/rag/ingest).
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_VOICE=true
