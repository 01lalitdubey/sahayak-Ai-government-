# ============================================================
# Sahayak AI — Backend Environment Variables
# ============================================================
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=Sahayak AI
APP_VERSION=0.1.0
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Security ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://sahayak:sahayak_password@localhost:5432/sahayak_db

# Set to true to log every SQL statement (useful for debugging)
DATABASE_ECHO=false

# Connection pool — tune for your server's PostgreSQL max_connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── CORS ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Government Data Module (Phase 6) ──────────────────────────────────────
# data.gov.in API key — register at https://data.gov.in/user/register
DATA_GOV_API_KEY=your-data-gov-in-api-key-here
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# HTTP client settings
GOVT_REQUEST_TIMEOUT=30
GOVT_MAX_RETRIES=3
GOVT_BACKOFF_FACTOR=2.0
GOVT_RATE_LIMIT_PER_MINUTE=60

# Feature flags (set to true to enable)
GOVT_ENABLE_SYNC=false
GOVT_ENABLE_CACHE=true

# Logging
GOVT_LOG_LEVEL=INFO

# Pagination & batching
GOVT_DEFAULT_PAGE_SIZE=100
GOVT_DEFAULT_BATCH_SIZE=500

# Sync schedule
GOVT_SYNC_INTERVAL_HOURS=24

# ── Translation (Phase 8.1A) ────────────────────────────────────────────────
TRANSLATION_PROVIDER=indictrans2
TRANSLATION_BATCH_SIZE=20
TRANSLATION_PILOT_LIMIT=100
TRANSLATION_MAX_RETRIES=3
TRANSLATION_ENABLE_CACHE=true
TRANSLATION_ENABLE_VERSIONING=true

# ── RAG / Voice Assistant ──────────────────────────────────────────────────
# One Groq key powers Whisper (ASR) + gpt-oss models (query translation & answers).
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
RAG_REQUEST_TIMEOUT=60

# Retrieval
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHROMA_MODE=local               # local (numpy, no deps) | persistent (chromadb) | http (server)
RAG_CHROMA_PATH=chroma_db           # storage dir for 'local' and 'persistent'
RAG_CHROMA_HOST=localhost           # used when RAG_CHROMA_MODE=http
RAG_CHROMA_PORT=8001
RAG_COLLECTION=sahayak_schemes
RAG_TOP_K=3
RAG_MAX_QUERY_CHARS=1000
RAG_MIN_SCORE=0.0

# Voice
RAG_ENABLE_ASR=true
RAG_ENABLE_TTS=true
RAG_AUDIO_DIR=app/static/rag_audio
RAG_AUDIO_TTL_MINUTES=120
# TTS routing for the 13 languages:
#   auto — gTTS where it has a voice, facebook/mms-tts-* (offline VITS) for
#          Odia/Assamese and as a fallback for everything else
#   gtts — gTTS first, MMS fallback
#   mms  — offline MMS for all 13 (no request-time internet; ~145 MB/model)
RAG_TTS_PROVIDER=auto
RAG_TTS_MMS_CACHE_DIR=.cache/hf_tts
RAG_TTS_MMS_MAX_MODELS=6
RAG_TTS_MAX_CHARS=1200
RAG_TTS_RETRIES=3
